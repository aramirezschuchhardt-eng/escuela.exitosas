# ─────────────────────────────────────────────────────────────────────────────
# Encuesta La Ruta Inmobiliaria — variables de entorno del SERVIDOR
#
# Copia este archivo como `.env` y complétalo en el servidor. Nada de esto
# llega al navegador: las credenciales viven sólo aquí. `.env` está ignorado
# por git a propósito.
# ─────────────────────────────────────────────────────────────────────────────

# Puerto y dirección del servidor
ENCUESTA_PUERTO=8787
ENCUESTA_HOST=0.0.0.0

# Dónde llegan las respuestas (requisito del proyecto)
ENCUESTA_CORREO_DESTINO=Alison@avanceinmobiliario.cl
# Copias opcionales, separadas por coma
# ENCUESTA_CORREO_COPIA=marketing@avanceinmobiliario.cl
ENCUESTA_CORREO_REMITENTE="Encuesta La Ruta Inmobiliaria <encuesta@avanceinmobiliario.cl>"
# Si se responde el correo, la respuesta va al participante
ENCUESTA_CORREO_RESPONDER_AL_PARTICIPANTE=true

# ── Cómo se envía el correo ──────────────────────────────────────────────────
# resend | smtp | registro   (si se deja vacío se detecta solo: Resend si hay
# RESEND_API_KEY, SMTP si hay SMTP_HOST, y si no, modo registro en consola)
ENCUESTA_TRANSPORTE_CORREO=

# Opción A — servicio transaccional (recomendado)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Opción B — SMTP propio (Google Workspace, Zoho, Office 365, hosting…)
# SMTP_HOST=smtp.tuservidor.cl
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=encuesta@avanceinmobiliario.cl
# SMTP_PASS=clave-de-aplicacion

# ── Panel administrativo ─────────────────────────────────────────────────────
# Token para entrar a /#/admin. Si se deja vacío, el panel sólo se puede abrir
# desde la misma máquina del servidor.
ENCUESTA_TOKEN_ADMIN=

# ── Base de datos y archivos ─────────────────────────────────────────────────
ENCUESTA_BASE_DATOS=datos/encuesta.sqlite
ENCUESTA_ESTATICOS=dist

# ── Reintentos de entrega ────────────────────────────────────────────────────
ENCUESTA_INTENTOS_ENTREGA=4
ENCUESTA_ESPERA_ENTREGA_MS=2000
ENCUESTA_BARRIDO_ENTREGAS_MS=120000

# ── Integraciones futuras (opcional) ─────────────────────────────────────────
# Publica cada respuesta en una URL: Zapier, Make o n8n conectados a Google
# Sheets, un CRM, WhatsApp o email marketing.
# ENCUESTA_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/000000/abcdef
# ENCUESTA_WEBHOOK_TOKEN=
